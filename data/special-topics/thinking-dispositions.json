ality-motive-mrm", "title": "Master rationality motive (MRM)", "level": 2}, {"id": "actively-open-minded-thinking-aot", "title": "Actively Open-Minded Thinking (AOT)", "level": 2}, {"id": "intellectual-humility", "title": "Intellectual Humility", "level": 2}, {"id": "skepticism", "title": "Skepticism", "level": 2}], "words": 56, "minutes": 1, "status": "outline", "referenceDetails": [], "context": ["Special Topics"], "seeAlso": []}